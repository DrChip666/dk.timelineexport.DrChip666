{
  "title": {
    "en": "Export the timeline",
    "da": "Eksportér tidslinjen"
  },
  "titleFormatted": {
    "en": "Export the timeline as [[format]] for [[period]]",
    "da": "Eksportér tidslinjen som [[format]] for [[period]]"
  },
  "hint": {
    "en": "Saves the timeline as a file on Homey. Use the card 'The timeline was exported' to send the link or content on. 'Yesterday' is the whole previous day, which suits daily exports. Needs a personal API key in the app settings.",
    "da": "Gemmer tidslinjen som en fil på Homey. Brug kortet 'Tidslinjen blev eksporteret' til at sende linket eller indholdet videre. 'I går' er hele den forrige dag, hvilket passer til daglige eksporter. Kræver en personlig API-nøgle i appens indstillinger."
  },
  "args": [
    {
      "name": "format",
      "type": "dropdown",
      "title": {
        "en": "File type",
        "da": "Filtype"
      },
      "values": [
        {
          "id": "csv",
          "label": {
            "en": "CSV",
            "da": "CSV"
          }
        },
        {
          "id": "json",
          "label": {
            "en": "JSON",
            "da": "JSON"
          }
        }
      ]
    },
    {
      "name": "period",
      "type": "dropdown",
      "title": {
        "en": "Period",
        "da": "Periode"
      },
      "values": [
        {
          "id": "all",
          "label": {
