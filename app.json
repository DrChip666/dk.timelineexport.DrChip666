  "api": {
    "getSummary": {
      "method": "GET",
      "path": "/summary"
    },
    "getExport": {
      "method": "GET",
      "path": "/export"
    },
    "getDownload": {
      "method": "GET",
      "path": "/download"
    },
    "setOrigin": {
      "method": "POST",
      "path": "/origin"
    }
  },
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "The timeline was exported",
          "da": "Tidslinjen blev eksporteret"
        },
        "hint": {
          "en": "Starts when an export file is ready. The links work for the link lifetime chosen in the app settings. The local link only works on your home network.",
          "da": "Starter, når en eksportfil er klar. Linkene virker i den levetid, der er valgt i appens indstillinger. Det lokale link virker kun på dit hjemmenetværk."
        },
        "tokens": [
          {
            "name": "local_url",
            "type": "string",
            "title": {
              "en": "Local link",
              "da": "Lokalt link"
            },
            "example": {
              "en": "http://192.168.1.50/app/.../homey-timeline.csv",
              "da": "http://192.168.1.50/app/.../homey-timeline.csv"
            }
          },
          {
            "name": "external_url",
            "type": "string",
            "title": {
              "en": "External link",
              "da": "Eksternt link"
            },
            "example": {
              "en": "https://.../homey-timeline.csv",
              "da": "https://.../homey-timeline.csv"
            }
          },
          {
            "name": "file_name",
            "type": "string",
            "title": {
              "en": "File name",
              "da": "Filnavn"
            },
            "example": {
              "en": "homey-timeline-2026-10-25-23-00-00.csv",
              "da": "homey-timeline-2026-10-25-23-00-00.csv"
            }
          },
          {
            "name": "count",
            "type": "number",
            "title": {
              "en": "Notifications",
              "da": "Antal notifikationer"
            },
            "example": 235
          },
          {
            "name": "format",
            "type": "string",
            "title": {
              "en": "File type",
              "da": "Filtype"
            },
            "example": {
              "en": "CSV",
              "da": "CSV"
            }
          },
          {
            "name": "period",
            "type": "string",
            "title": {
              "en": "Period",
              "da": "Periode"
            },
            "example": {
              "en": "2026-10-18 09:12:00 – 2026-10-25 22:41:00",
              "da": "2026-10-18 09:12:00 – 2026-10-25 22:41:00"
            }
          },
          {
            "name": "expires",
            "type": "string",
            "title": {
              "en": "Link expires",
              "da": "Link udløber"
            },
            "example": {
              "en": "2026-10-26 23:00:00",
              "da": "2026-10-26 23:00:00"
            }
          }
        ],
        "id": "timeline_exported"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Export the timeline",
          "da": "Eksportér tidslinjen"
        },
        "titleFormatted": {
          "en": "Export the timeline as [[format]] for [[period]]",
          "da": "Eksportér tidslinjen som [[format]] for [[period]]"
        },
        "hint": {
          "en": "Saves the timeline as a file on Homey. Use the card 'The timeline was exported' to send the link on. Needs an API key in the app settings on newer Homey Pro models.",
          "da": "Gemmer tidslinjen som en fil på Homey. Brug kortet 'Tidslinjen blev eksporteret' til at sende linket videre. Kræver en API-nøgle i appens indstillinger på nyere Homey Pro-modeller."
        },
        "args": [
          {
            "name": "format",
            "type": "dropdown",
            "title": {
              "en": "File type",
              "da": "Filtype"
            },
            "values": [
              {
                "id": "csv",
                "label": {
                  "en": "CSV",
                  "da": "CSV"
                }
              },
              {
                "id": "json",
                "label": {
                  "en": "JSON",
                  "da": "JSON"
                }
              }
            ]
          },
          {
            "name": "period",
            "type": "dropdown",
            "title": {
              "en": "Period",
              "da": "Periode"
            },
            "values": [
              {
                "id": "all",
                "label": {
                  "en": "the whole timeline",
                  "da": "hele tidslinjen"
                }
              },
              {
                "id": "day",
                "label": {
                  "en": "the last 24 hours",
                  "da": "de seneste 24 timer"
                }
              },
              {
                "id": "week",
                "label": {
                  "en": "the last 7 days",
                  "da": "de seneste 7 dage"
                }
              },
              {
                "id": "month",
                "label": {
                  "en": "the last 30 days",
                  "da": "de seneste 30 dage"
                }
              }
            ]
          }
        ],
        "id": "export_timeline"
      }
    ]
  }
}